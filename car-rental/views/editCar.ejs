<!DOCTYPE html>
<html lang="en">

<head>
    <title>Edit Car</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="navbar">
        <a href="/dashboard">Home</a>
        <a href="/logout">Logout</a>
    </div>

    <h2>Edit Car</h2>
    <form method="POST" action="/cars/update/<%= car._id %>">
        <input type="text" name="name" value="<%= car.name %>" required>
        <input type="text" name="description" value="<%= car.description %>" required>
        <input type="number" name="price" value="<%= car.price %>" required>
        <input type="text" name="imageUrl" value="<%= car.imageUrl %>" required>
        <button type="submit">Update Car</button>
    </form>

</body>

</html>